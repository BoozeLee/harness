{
  "gates": {
    "unit": {
      "cmd": "uv run pytest -q",
      "min_risk": "low"
    },
    "lint": {
      "cmd": "uv run ruff check .",
      "min_risk": "low"
    },
    "typecheck": {
      "cmd": "uv run mypy harness/",
      "min_risk": "medium"
    }
  },
  "review": true,
  "schema_version": 1
}